# Africa of Hope — Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Supabase project values.

# Server
PORT=4000
NODE_ENV=production

# JWT — use a long random string (32+ chars)
SESSION_SECRET=your-long-random-secret-here

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Project URL  (e.g. https://xyzxyz.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key — grants full DB access, bypasses RLS.
# KEEP THIS SECRET — never expose in frontend code or public repos.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://africaofhope.vercel.app,https://africaofhope.org
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://africaofhope.org
