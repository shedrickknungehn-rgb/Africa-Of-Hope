# Africa of Hope — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables

# URL of your Express backend (no trailing slash)
# Example: https://api.africaofhope.org  or  https://aoh-api.up.railway.app
VITE_API_URL=https://your-backend-url.com
